# Node-RED base URL used by the Vite dev/preview proxy (server side only).
NODE_RED_URL=http://localhost:1880

# Optional: only when the dashboard is NOT served through the proxy above.
# Leave empty so the admin session cookie stays same-origin.
# Never put secrets in VITE_* variables — they are bundled into the browser code.
VITE_API_URL=
VITE_WS_URL=
