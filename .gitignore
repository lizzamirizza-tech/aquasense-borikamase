# ---------------------------------------------------------------
# AquaSense Borikamase — root .gitignore
# Applies to website/ now and to firmware/ and node-red/ later.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output (React + Vite)
dist/
dist-ssr/
build/
*.local

# Vite / tooling cache
.vite/
.cache/
.eslintcache
*.tsbuildinfo
coverage/

# Environment & secrets — only .env.example is committed
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
*_cred*.json
flows_cred.json

# Local backups & temporary files
backup/
backups/
*.bak
*.tmp
*.temp
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# PlatformIO / Arduino build output (for future firmware/)
.pio/
.pioenvs/
.piolibdeps/
